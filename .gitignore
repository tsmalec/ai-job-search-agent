# Secrets: never commit keys or OAuth tokens
.env
.env.*
*.env
client_secret*.json
*token*.json
data/model.json

# Your search rules (contact, home, pay floor). A PRIVATE copy may remove this line to sync it to a scheduler.
config.json

# Credentials in any common shape
credentials*.json
*.pickle
*.pem
*.key
.jobsearch/

# Sample-loop test fixtures (fictional data) must be committed even though their names match the scratch patterns above
!tests/fixtures/**

# Temp files from atomic writes (a killed process can leave one)
.*.tmp
# The fixtures exception above must never let credentials in
tests/fixtures/**/credentials*.json
tests/fixtures/**/client_secret*.json
tests/fixtures/**/*token*.json
tests/fixtures/**/*.pickle
tests/fixtures/**/*.pem
tests/fixtures/**/*.key
tests/fixtures/**/.env
